{
  "info": {
    "name": "Reservation Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "role",
      "value": "USER",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "ReservationController (USER)",
      "item": [
        {
          "name": "예약 생성",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/reservations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "reservations"]
            },
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-Role", "value": "{{role}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slotId\": \"\",\n  \"bookerName\": \"\",\n  \"bookerPhone\": \"\",\n  \"reservationSize\": 1,\n  \"requestMessage\": \"\",\n  \"paymentMethod\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "내 예약 목록 조회",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/reservations/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "reservations", "me"]
            },
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-Role", "value": "{{role}}" }
            ]
          }
        },
        {
          "name": "내 예약 상세 조회",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/reservations/me/:reservationId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "reservations", "me", ":reservationId"],
              "variable": [{ "key": "reservationId", "value": "" }]
            },
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-Role", "value": "{{role}}" }
            ]
          }
        },
        {
          "name": "예약 취소",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/v1/reservations/:reservationId/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "reservations", ":reservationId", "cancel"],
              "variable": [{ "key": "reservationId", "value": "" }]
            },
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-Role", "value": "{{role}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cancelReason\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
    {
      "name": "StoreReservationController (OWNER)",
      "item": [
        {
          "name": "매장 예약 목록 조회",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/stores/:storeId/reservations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stores", ":storeId", "reservations"],
              "variable": [{ "key": "storeId", "value": "" }]
            },
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-Role", "value": "{{role}}" }
            ]
          }
        },
        {
          "name": "매장 예약 상세 조회",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/stores/:storeId/reservations/:reservationId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stores", ":storeId", "reservations", ":reservationId"],
              "variable": [
                { "key": "storeId", "value": "" },
                { "key": "reservationId", "value": "" }
              ]
            },
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-Role", "value": "{{role}}" }
            ]
          }
        },
        {
          "name": "매장측 예약 취소",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/v1/stores/:storeId/reservations/:reservationId/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stores", ":storeId", "reservations", ":reservationId", "cancel"],
              "variable": [
                { "key": "storeId", "value": "" },
                { "key": "reservationId", "value": "" }
              ]
            },
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-Role", "value": "{{role}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cancelReason\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "방문 확인 처리",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/v1/stores/:storeId/reservations/:reservationId/visit",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stores", ":storeId", "reservations", ":reservationId", "visit"],
              "variable": [
                { "key": "storeId", "value": "" },
                { "key": "reservationId", "value": "" }
              ]
            },
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-Role", "value": "{{role}}" }
            ]
          }
        },
        {
          "name": "노쇼 처리",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/v1/stores/:storeId/reservations/:reservationId/no-show",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stores", ":storeId", "reservations", ":reservationId", "no-show"],
              "variable": [
                { "key": "storeId", "value": "" },
                { "key": "reservationId", "value": "" }
              ]
            },
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-Role", "value": "{{role}}" }
            ]
          }
        }
      ]
    },
    {
      "name": "SlotController (USER)",
      "item": [
        {
          "name": "가게별 예약 가능 슬롯 조회",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/reservations/slots/:storeId?date=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "reservations", "slots", ":storeId"],
              "variable": [{ "key": "storeId", "value": "" }],
              "query": [
                { "key": "date", "value": "", "description": "선택 (yyyy-MM-dd), 미입력 시 오늘 이후 전체 조회" }
              ]
            },
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-Role", "value": "{{role}}" }
            ]
          }
        }
      ]
    },
    {
      "name": "SlotController (OWNER)",
      "item": [
        {
          "name": "슬롯 생성",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/slots",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "slots"]
            },
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-Role", "value": "{{role}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storeId\": \"\",\n  \"slotDate\": \"2026-06-24\",\n  \"slotTime\": \"19:00\",\n  \"maxCapacity\": 1,\n  \"depositRequired\": false,\n  \"depositAmount\": null\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "슬롯 목록 조회",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/slots?storeId=&date=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "slots"],
              "query": [
                { "key": "storeId", "value": "" },
                { "key": "date", "value": "", "description": "선택 (yyyy-MM-dd)" }
              ]
            },
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-Role", "value": "{{role}}" }
            ]
          }
        },
        {
          "name": "슬롯 상세 조회",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/slots/:slotId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "slots", ":slotId"],
              "variable": [{ "key": "slotId", "value": "" }]
            },
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-Role", "value": "{{role}}" }
            ]
          }
        },
        {
          "name": "슬롯 수정",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/v1/slots/:slotId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "slots", ":slotId"],
              "variable": [{ "key": "slotId", "value": "" }]
            },
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-Role", "value": "{{role}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slotDate\": null,\n  \"slotTime\": null,\n  \"maxCapacity\": null,\n  \"depositRequired\": null,\n  \"depositAmount\": null\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "슬롯 삭제",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/v1/slots/:slotId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "slots", ":slotId"],
              "variable": [{ "key": "slotId", "value": "" }]
            },
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-Role", "value": "{{role}}" }
            ]
          }
        }
      ]
    },
    {
      "name": "ReservationInternalController (INTERNAL)",
      "item": [
        {
          "name": "슬롯 정원 Redis 값 복구",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/internal/reservations/stores/:storeId/capacity/restore?slotDate=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "internal", "reservations", "stores", ":storeId", "capacity", "restore"],
              "variable": [{ "key": "storeId", "value": "" }],
              "query": [
                { "key": "slotDate", "value": "", "description": "선택 (yyyy-MM-dd), 미입력 시 오늘 이후 OPEN 슬롯 전체 대상" }
              ]
            }
          }
        }
      ]
    }
  ]
}
