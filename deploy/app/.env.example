RDS_ENDPOINT=kok-dev-postgres.xxxxxxxxxxxx.ap-northeast-2.rds.amazonaws.com
INFRA_PRIVATE_IP=10.0.1.10
MONITORING_PRIVATE_IP=10.0.1.20

IMAGE_REGISTRY=123456789012.dkr.ecr.ap-northeast-2.amazonaws.com
IMAGE_TAG=latest

EUREKA_SERVER_IMAGE=${IMAGE_REGISTRY}/kok-eureka-server:${IMAGE_TAG}
API_GATEWAY_IMAGE=${IMAGE_REGISTRY}/kok-api-gateway:${IMAGE_TAG}
USER_SERVICE_IMAGE=${IMAGE_REGISTRY}/kok-user-service:${IMAGE_TAG}
STORE_SERVICE_IMAGE=${IMAGE_REGISTRY}/kok-store-service:${IMAGE_TAG}
RESERVATION_SERVICE_IMAGE=${IMAGE_REGISTRY}/kok-reservation-service:${IMAGE_TAG}
WAITING_SERVICE_IMAGE=${IMAGE_REGISTRY}/kok-waiting-service:${IMAGE_TAG}
NOTIFICATION_SERVICE_IMAGE=${IMAGE_REGISTRY}/kok-notification-service:${IMAGE_TAG}
REVIEW_SERVICE_IMAGE=${IMAGE_REGISTRY}/kok-review-service:${IMAGE_TAG}
PAYMENT_SERVICE_IMAGE=${IMAGE_REGISTRY}/kok-payment-service:${IMAGE_TAG}

DB_USERNAME=kokadmin
DB_PASSWORD=CHANGE_ME
JPA_DDL_AUTO=update

JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
TRACING_SAMPLING_PROBABILITY=1.0

SLACK_BOT_TOKEN=

EUREKA_JAVA_OPTS=-Xms128m -Xmx256m
GATEWAY_JAVA_OPTS=-Xms128m -Xmx256m
USER_JAVA_OPTS=-Xms128m -Xmx256m
STORE_JAVA_OPTS=-Xms128m -Xmx256m
RESERVATION_JAVA_OPTS=-Xms128m -Xmx256m
WAITING_JAVA_OPTS=-Xms128m -Xmx256m
NOTIFICATION_JAVA_OPTS=-Xms128m -Xmx256m
REVIEW_JAVA_OPTS=-Xms128m -Xmx256m
PAYMENT_JAVA_OPTS=-Xms128m -Xmx256m
