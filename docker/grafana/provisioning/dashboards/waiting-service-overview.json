  "panels": [
    {
      "id": 1,
      "title": "waiting-service UP",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{instance=~\".*:8004\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "HTTP Requests/sec",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, uri, status) (rate(http_server_requests_seconds_count{instance=~\".*:8004\", uri!~\"/actuator.*\"}[1m]))",
          "legendFormat": "{{method}} {{uri}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "HTTP Latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 14,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (method, uri, status) (rate(http_server_requests_seconds_sum{instance=~\".*:8004\", uri!~\"/actuator.*\"}[1m])) / sum by (method, uri, status) (rate(http_server_requests_seconds_count{instance=~\".*:8004\", uri!~\"/actuator.*\"}[1m]))) * 1000",
          "legendFormat": "{{method}} {{uri}} {{status}} avg"
        },
        {
          "refId": "B",
          "expr": "max by (method, uri, status) (http_server_requests_seconds_max{instance=~\".*:8004\", uri!~\"/actuator.*\"}) * 1000",
          "legendFormat": "{{method}} {{uri}} {{status}} max"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Process CPU",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_cpu_usage{instance=~\".*:8004\"}",
          "legendFormat": "process cpu"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "JVM Memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (area) (jvm_memory_used_bytes{instance=~\".*:8004\"})",
          "legendFormat": "{{area}} used"
        },
        {
          "refId": "B",
          "expr": "sum by (area) (jvm_memory_max_bytes{instance=~\".*:8004\"})",
          "legendFormat": "{{area}} max"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "HikariCP Connections",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active{instance=~\".*:8004\"}",
          "legendFormat": "active"
        },
        {
          "refId": "B",
          "expr": "hikaricp_connections_idle{instance=~\".*:8004\"}",
          "legendFormat": "idle"
        },
        {
          "refId": "C",
          "expr": "hikaricp_connections_pending{instance=~\".*:8004\"}",
          "legendFormat": "pending"
        },
        {
          "refId": "D",
          "expr": "hikaricp_connections_max{instance=~\".*:8004\"}",
          "legendFormat": "max"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "DB Pool Pressure",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(hikaricp_connections_timeout_total{instance=~\".*:8004\"}[1m])",
          "legendFormat": "connection timeout/sec"
        },
        {
          "refId": "B",
          "expr": "hikaricp_connections_acquire_seconds_max{instance=~\".*:8004\"} * 1000",
          "legendFormat": "acquire max ms"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Kafka Producer / Consumer",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(kafka_producer_record_send_total{instance=~\".*:8004\"}[1m]))",
          "legendFormat": "producer sends/sec"
        },
        {
          "refId": "B",
          "expr": "sum(rate(kafka_consumer_fetch_manager_records_consumed_total{instance=~\".*:8004\"}[1m]))",
          "legendFormat": "consumer records/sec"
