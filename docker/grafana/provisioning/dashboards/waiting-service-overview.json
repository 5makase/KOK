        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kafka_producer_request_latency_avg{instance=~\".*:8004\"}",
          "legendFormat": "producer request avg"
        },
        {
          "refId": "B",
          "expr": "kafka_consumer_fetch_manager_fetch_latency_avg{instance=~\".*:8004\"}",
          "legendFormat": "consumer fetch avg"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Redis Commands",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(lettuce_command_completion_seconds_count{instance=~\".*:8004\"}[1m]))",
          "legendFormat": "lettuce commands/sec"
        },
        {
          "refId": "B",
          "expr": "(sum(rate(lettuce_command_completion_seconds_sum{instance=~\".*:8004\"}[1m])) / sum(rate(lettuce_command_completion_seconds_count{instance=~\".*:8004\"}[1m]))) * 1000",
          "legendFormat": "lettuce avg latency ms"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
