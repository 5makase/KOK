project_name = "kok"
environment  = "dev"
aws_region   = "ap-northeast-2"

vpc_cidr           = "10.0.0.0/16"
public_subnet_cidr = "10.0.1.0/24"
private_subnet_cidrs = [
  "10.0.11.0/24",
  "10.0.12.0/24"
]

# Replace with your current public IP address for SSH.
# Example: "203.0.113.10/32"
ssh_cidr = "YOUR_PUBLIC_IP/32"

# Management UIs are open for team access during the demo.
# Grafana(:3000), Prometheus(:9090), Kafka UI(:8080), Zipkin(:9411)
admin_ui_cidr = "0.0.0.0/0"

rds_instance_class    = "db.t3.micro"
rds_engine_version    = "16.14"
rds_allocated_storage = 20
rds_database_name     = "kok"
rds_master_username   = "kokadmin"

# Set a strong password in terraform.tfvars. Do not commit terraform.tfvars.
rds_master_password = "CHANGE_ME_STRONG_PASSWORD"
